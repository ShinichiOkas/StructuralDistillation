 "units": [
  {
   "id": "s1",
   "text": "当社の新型掃除ロボットは、当初四月一日の発売を予定していた。"
  },
  {
   "id": "s2",
   "text": "三月中旬、充電台の部品に不具合が見つかり、発売は五月一日に延期された。"
  },
  {
   "id": "s3",
   "text": "四月下旬、部品の供給が間に合わず、発売はさらに五月二十日に延期された。"
  },
  {
   "id": "s4",
   "text": "五月二十日、全国の量販店で発売が始まった。"
  },
  {
   "id": "s5",
   "text": "初週の出荷台数は計画の九割だった。"
  },
  {
   "id": "s6",
   "text": "営業部長は「二度の延期は痛かったが、品質を優先した判断だった」と述べた。"
  },
  {
   "id": "s7",
   "text": "予約していた顧客には、延期のたびに案内の手紙を送った。"
  }
 ],

 "proposition": "差出人は相手に謝罪している",
 "units_rule": "ja-sentence/v1",
 "units": [
  {
   "id": "s1",
   "text": "先週の土曜日のことで、手紙を書いています。"
  },
  {
   "id": "s2",
   "text": "駅で一時間も待たせてしまい、本当に申し訳ありませんでした。"
  },
  {
   "id": "s3",
   "text": "前の晩に時計の設定を間違えたのは私の不注意です。"
  },
  {
   "id": "s4",
   "text": "連絡をしなかったのも、慌てて携帯を家に忘れたからで、言い訳にはなりません。"
  },
  {
   "id": "s5",
   "text": "せっかく取ってくれた昼の予約も無駄にしてしまいました。"
  },
  {
   "id": "s6",
   "text": "今度は私が店を予約して、代金も持たせてください。"
  },
  {
   "id": "s7",
   "text": "都合のよい日を教えてもらえると助かります。"
  },
  {
   "id": "s8",
   "text": "これに懲りずに、また会ってください。"
  }
 ],

 "proposition": "このレシピは分量と火加減と時間を数値で指定している",
 "units_rule": "ja-sentence/v1",
 "units": [
  {
   "id": "s1",
   "text": "材料（二人分）: 豚こま切れ肉二百グラム、玉ねぎ一個、しょうゆ大さじ一、みりん大さじ一、サラダ油小さじ二。"
  },
  {
   "id": "s2",
   "text": "手順: 一、玉ねぎを薄切りにする。"
  },
  {
   "id": "s3",
   "text": "二、フライパンに油を入れ、中火で温める。"
  },
  {
   "id": "s4",
   "text": "三、豚肉を入れ、色が変わるまで二分ほど炒める。"
  },
  {
   "id": "s5",
   "text": "四、玉ねぎを加え、しんなりするまで三分ほど炒める。"
  },
  {
   "id": "s6",
   "text": "五、しょうゆとみりんを回し入れ、一分炒めて火を止める。"
  },
  {
   "id": "s7",
   "text": "調理時間: 約十分。"
  },
  {
   "id": "s8",
   "text": "使う道具: 包丁、まな板、フライパン、大さじ。"
  },
  {
   "id": "s9",
   "text": "コツ: 肉は重ならないように広げて入れる。"
  },
  {
   "id": "s10",
   "text": "失敗しやすい点: 火が強すぎると調味料が焦げるので、五の工程は中火のまま。"
  }
 ],

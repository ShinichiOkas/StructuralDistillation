 "units": [
  {
   "id": "s1",
   "text": "議題: 予約アプリに「友人と席を共有する」機能を入れるか。"
  },
  {
   "id": "s2",
   "text": "営業の川田は、法人客から要望が三件来ていると述べた。"
  },
  {
   "id": "s3",
   "text": "開発の森は、実装に約二か月かかり、現在の改修が遅れると述べた。"
  },
  {
   "id": "s4",
   "text": "サポートの葉山は、共有された席の取り消しをどちらが行えるかで問い合わせが増えると懸念を示した。"
  },
  {
   "id": "s5",
   "text": "川田は取り消しは共有した側だけができればよいと答えた。"
  },
  {
   "id": "s6",
   "text": "森は仕様が固まれば見積もりを出し直すと述べた。"
  },
  {
   "id": "s7",
   "text": "議長は、仕様の論点を川田と葉山で来週までにまとめること、採否は次回の会議で判断することを確認した。"
  },
  {
   "id": "s8",
   "text": "決定事項: なし。"
  },
  {
   "id": "s9",
   "text": "宿題: 仕様の論点整理（川田・葉山、期限は来週金曜）。"
  }
 ],

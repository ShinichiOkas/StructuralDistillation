 "units": [
  {
   "id": "s1",
   "text": "ぼくには二年生の弟がいます。"
  },
  {
   "id": "s2",
   "text": "土曜日、弟がぼくのゲームを貸してと言いました。"
  },
  {
   "id": "s3",
   "text": "ぼくは前に弟がコントローラーを落として壊したので、貸しませんでした。"
  },
  {
   "id": "s4",
   "text": "弟は泣いて、お母さんに言いつけました。"
  },
  {
   "id": "s5",
   "text": "ぼくは弟のことをずるいと思いました。"
  },
  {
   "id": "s6",
   "text": "日曜日、弟がお気に入りのカードをなくして泣いていました。"
  },
  {
   "id": "s7",
   "text": "ぼくは一緒に家じゅうをさがして、ソファの下で見つけました。"
  },
  {
   "id": "s8",
   "text": "弟はありがとうと言いました。"
  },
  {
   "id": "s9",
   "text": "夜、弟の算数の宿題がわからないと言うので、ぼくが教えました。"
  },
  {
   "id": "s10",
   "text": "でもぼくは途中でめんどうになって、答えを書いてしまいました。"
  },
  {
   "id": "s11",
   "text": "お母さんには内緒です。"
  }
 ],

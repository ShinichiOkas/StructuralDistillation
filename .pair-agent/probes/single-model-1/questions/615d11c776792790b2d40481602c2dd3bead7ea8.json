 "proposition": "旅は計画どおりに進んだ",
 "units_rule": "ja-sentence/v1",
 "units": [
  {
   "id": "s1",
   "text": "計画では、初日に港町と城下町、二日目に温泉町と湖畔の町、三日目に帰るはずだった。"
  },
  {
   "id": "s2",
   "text": "初日の朝、乗るはずだった特急が強風で止まった。"
  },
  {
   "id": "s3",
   "text": "代わりのバスは満席で、港町に着いたのは夕方だった。"
  },
  {
   "id": "s4",
   "text": "城下町は翌日に回した。"
  },
  {
   "id": "s5",
   "text": "二日目は城下町で半日を使い、温泉町に着いたのは夜。"
  },
  {
   "id": "s6",
   "text": "湖畔の町には行けなかった。"
  },
  {
   "id": "s7",
   "text": "三日目、温泉町の朝市で買った干物を抱えて帰った。"
  },
  {
   "id": "s8",
   "text": "四つのうち三つの町を回れた。"
  },
  {
   "id": "s9",
   "text": "宿はどこも予約どおりに取れていた。"
  },
  {
   "id": "s10",
   "text": "予定は崩れたが、港町の夕焼けは計画にはなかった収穫だった。"
  }
 ],

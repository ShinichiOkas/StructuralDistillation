 "proposition": "この週は雨の日が多かった",
 "units_rule": "ja-sentence/v1",
 "units": [
  {
   "id": "s1",
   "text": "六月八日、晴れ。"
  },
  {
   "id": "s2",
   "text": "最高気温二十七度。"
  },
  {
   "id": "s3",
   "text": "六月九日、晴れのち曇り。"
  },
  {
   "id": "s4",
   "text": "夕方に雲が出たが降らず。"
  },
  {
   "id": "s5",
   "text": "六月十日、晴れ。"
  },
  {
   "id": "s6",
   "text": "洗濯物がよく乾いた。"
  },
  {
   "id": "s7",
   "text": "六月十一日、曇り。"
  },
  {
   "id": "s8",
   "text": "一日中どんよりしていたが雨は無し。"
  },
  {
   "id": "s9",
   "text": "六月十二日、晴れ。"
  },
  {
   "id": "s10",
   "text": "六月十三日、雨。"
  },
  {
   "id": "s11",
   "text": "朝から夕方まで降り続き、雨量は十八ミリ。"
  },
  {
   "id": "s12",
   "text": "六月十四日、晴れ。"
  },
  {
   "id": "s13",
   "text": "前日の雨で庭の土が湿っていた。"
  },
  {
   "id": "s14",
   "text": "週のまとめ: 雨が降ったのは一日だけ。"
  }

 "units": [
  {
   "id": "s1",
   "text": "仮説: 肥料 A を加えると小松菜の発芽率が上がる。"
  },
  {
   "id": "s2",
   "text": "方法: 同じ土を入れた鉢を二十個ずつ二組用意し、一組には肥料 A を規定量、もう一組には水だけを与える。"
  },
  {
   "id": "s3",
   "text": "温度と日照は同じ棚で揃えた。"
  },
  {
   "id": "s4",
   "text": "七日目に発芽した鉢を数えた。"
  },
  {
   "id": "s5",
   "text": "結果: 肥料 A の組は二十鉢中十二鉢、水だけの組は二十鉢中十三鉢。"
  },
  {
   "id": "s6",
   "text": "八日目に数え直しても同じ。"
  },
  {
   "id": "s7",
   "text": "考察: 二組の差は一鉢で、肥料 A の効果は見られなかった。"
  },
  {
   "id": "s8",
   "text": "むしろ肥料 A の組で葉が黄色い株が三つあった。"
  },
  {
   "id": "s9",
   "text": "次回は肥料の量を半分にして試す。"
  }
 ],

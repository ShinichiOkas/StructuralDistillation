 "units": [
  {
   "id": "s1",
   "text": "件名: 設定画面で保存ボタンを押すとアプリが終了する。"
  },
  {
   "id": "s2",
   "text": "環境: Windows 11、アプリ版 2.3.1、画面の拡大率 150%。"
  },
  {
   "id": "s3",
   "text": "手順: 1. アプリを起動する。"
  },
  {
   "id": "s4",
   "text": "2. 右上の歯車から設定画面を開く。"
  },
  {
   "id": "s5",
   "text": "3. 「通知」タブでトグルを一つ切り替える。"
  },
  {
   "id": "s6",
   "text": "4. 画面下の保存ボタンを押す。"
  },
  {
   "id": "s7",
   "text": "期待結果: 設定が保存され、設定画面が閉じる。"
  },
  {
   "id": "s8",
   "text": "実際の結果: アプリのウィンドウが消え、プロセスも終了している。"
  },
  {
   "id": "s9",
   "text": "再現率: 3 回試して 3 回。"
  },
  {
   "id": "s10",
   "text": "ログ末尾: settings.save: KeyError 'notify_channel'。"
  },
  {
   "id": "s11",
   "text": "拡大率を 100% に戻しても同じ。"
  },
  {
   "id": "s12",
   "text": "版 2.3.0 では起きない。"
  }
 ],
